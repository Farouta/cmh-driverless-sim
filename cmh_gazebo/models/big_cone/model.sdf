<?xml version='1.0'?>
<sdf version='1.10'>
  <model name='big_cone'>
    <!-- Visual only: static cones are not simulated, so they cost no physics time -->
    <static>true</static>
    <link name='link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.05</mass>
        <inertia>
          <ixx>0.0016</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0016</iyy>
          <iyz>0</iyz>
          <izz>0.0010</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://cmh_gazebo/meshes/cone_big.dae</uri>
          </mesh> 
        </geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <collision name='collision'>
        <!-- Flat box at the base: the only part of the cone the car can bump into -->
        <pose>0 0 0.05 0 0 0</pose>
        <max_contacts>3</max_contacts>
        <geometry>
          <box><size>0.3 0.3 0.1</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>