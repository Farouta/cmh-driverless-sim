<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cmh_description</name>
  <version>2.0.0</version>
  <description>URDF/xacro model, meshes and vehicle parameter configs of the CMH driverless car.</description>

  <maintainer email="fourat.amri@hotmail.com">Fourat Zai El Amri</maintainer>

  <license>MIT</license>

  <url type="repository">https://github.com/Farouta/fs-driverless-sim</url>
  <url type="bugtracker">https://github.com/Farouta/fs-driverless-sim/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>cmh_sensors</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
